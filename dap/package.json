{
  "$schema": "https://fresh-editor.dev/schemas/package.schema.json",
  "name": "dap",
  "version": "0.1.0",
  "description": "Debug Adapter Protocol client with breakpoints, variables, and stepping",
  "type": "plugin",
  "author": "asukaminato0721",
  "license": "MIT",
  "repository": "https://github.com/asukaminato0721/fresh-plugins#dap",
  "keywords": [
    "debug",
    "dap",
    "breakpoint",
    "debugger"
  ],
  "fresh": {
    "min_version": "0.5.3",
    "min_api_version": 2,
    "entry": "dap.ts",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Debug Adapter Protocol",
      "type": "object",
      "properties": {
        "launchJson": {
          "type": "string",
          "default": ".vscode/launch.json",
          "description": "Workspace-relative path to a VS Code-compatible launch.json file."
        },
        "configuration": {
          "type": "string",
          "description": "Name of the launch configuration to use. The first configuration is used when omitted."
        },
        "adapters": {
          "type": "array",
          "description": "Commands used to start debug adapters, keyed by launch configuration type.",
          "items": {
            "type": "object",
            "required": [
              "type",
              "command"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "launch.json type, for example python or lldb."
              },
              "command": {
                "type": "string",
                "description": "Debug adapter executable."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Adapter working directory. Supports ${workspaceFolder} and ${file}."
              }
            }
          },
          "default": []
        },
        "pythonCommand": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 executable for the packaged DAP bridge."
        }
      }
    }
  }
}
